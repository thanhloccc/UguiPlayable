.ugp-tween-clip {
    padding: 4px 0;
}

.ugp-tween-clip__header {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 4px;
}

.ugp-tween-clip__header-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.ugp-tween-clip__title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.ugp-tween-clip__count {
    color: var(--ugp-tween-clip-secondary);
}

.ugp-tween-clip__note {
    margin: 2px 0 4px 0;
    white-space: normal;
    color: var(--ugp-tween-clip-secondary);
}

.ugp-tween-card {
    margin-top: 4px;
    padding: 4px 6px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--ugp-tween-card-border);
    background-color: var(--ugp-tween-card-background);
}

.ugp-tween-card__header {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.ugp-tween-card__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.ugp-tween-card__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    -unity-font-style: bold;
}

.ugp-tween-card__header > .ugp-switch {
    margin-left: 0;
    margin-right: 10px;
}

.ugp-tween-card--disabled .ugp-tween-card__header > .ugp-tween-card__icon,
.ugp-tween-card--disabled .ugp-tween-card__name {
    opacity: 0.5;
}

/* An off channel shows only its switch, icon and name; the mode control returns when it is turned on. */
.ugp-tween-card--disabled .ugp-segmented {
    display: none;
}

.ugp-tween-card__body {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--ugp-tween-card-border);
}

.ugp-tween-card__row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    margin: 1px 0;
}

.ugp-tween-card__row-label {
    width: 44px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ugp-tween-clip-secondary);
}

.ugp-tween-card--wide-labels .ugp-tween-card__row-label {
    width: 80px;
}

.ugp-tween-card__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.ugp-tween-card__row-label--text {
    width: 58px;
}

.ugp-tween-card__row--top {
    align-items: flex-start;
}

.ugp-tween-card__text-field {
    min-height: 44px;
}

.ugp-tween-card__text-field .unity-base-text-field__input {
    white-space: normal;
}

.ugp-tween-card__gradient {
    flex-direction: column;
}

.ugp-tween-card__gradient-row {
    flex-direction: row;
}

.ugp-tween-card__gradient-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 1px 2px 1px 0;
}

.ugp-tween-card__gradient-field > .unity-base-field__label {
    min-width: 20px;
    width: 20px;
}

.ugp-tween-card__icon-button {
    flex-shrink: 0;
    width: 22px;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 2px;
    align-items: center;
    justify-content: center;
}

.ugp-tween-card__icon-button > .ugp-tween-card__icon {
    margin-right: 0;
}

.ugp-tween-card__icon-button--on {
    background-color: var(--ugp-tween-card-toggle-on);
}

.ugp-tween-card__axis-group > .ugp-tween-card__axis-button {
    width: 30px;
    padding: 0;
    color: var(--ugp-tween-card-axis-off-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.ugp-tween-card__axis-group > .ugp-tween-card__axis-button.ugp-tween-card__axis-button--mixed {
    -unity-font-style: italic;
    border-bottom-color: var(--ugp-tween-card-axis-off-text);
}

.ugp-tween-card__axis-button--x.ugp-tween-card__axis-button--on {
    color: var(--ugp-tween-card-axis-x);
    border-bottom-color: var(--ugp-tween-card-axis-x);
}

.ugp-tween-card__axis-button--y.ugp-tween-card__axis-button--on {
    color: var(--ugp-tween-card-axis-y);
    border-bottom-color: var(--ugp-tween-card-axis-y);
}

.ugp-tween-card__axis-button--z.ugp-tween-card__axis-button--on {
    color: var(--ugp-tween-card-axis-z);
    border-bottom-color: var(--ugp-tween-card-axis-z);
}

.ugp-tween-card__axis-button--w.ugp-tween-card__axis-button--on {
    color: var(--ugp-tween-card-axis-w);
    border-bottom-color: var(--ugp-tween-card-axis-w);
}

.ugp-tween-card__percent {
    width: 36px;
    flex-shrink: 0;
    margin-left: 4px;
    -unity-text-align: middle-right;
    color: var(--ugp-tween-clip-secondary);
}

.ugp-tween-card__row-label--wide {
    width: 96px;
}
