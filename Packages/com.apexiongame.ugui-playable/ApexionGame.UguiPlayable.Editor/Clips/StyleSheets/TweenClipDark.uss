.ugp-tween-clip {
    --ugp-tween-clip-secondary: #bdbdbd;
    --ugp-tween-card-background: #303030;
    --ugp-tween-card-border: #454545;
    --ugp-tween-card-toggle-on: #2f7fd0;
    --ugp-tween-card-toggle-on-text: #ffffff;
    --ugp-tween-card-axis-border: #1e1e1e;
    --ugp-tween-card-axis-off: #383838;
    --ugp-tween-card-axis-off-text: #7c7c7c;
    --ugp-tween-card-axis-hover: rgba(255, 255, 255, 0.06);
    --ugp-tween-card-axis-x: #ff6b5e;
    --ugp-tween-card-axis-y: #8fd14f;
    --ugp-tween-card-axis-z: #5ea2ff;
    --ugp-tween-card-axis-w: #f0b43c;
}
