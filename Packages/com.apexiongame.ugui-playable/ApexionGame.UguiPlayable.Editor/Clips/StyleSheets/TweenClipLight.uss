.ugp-tween-clip {
    --ugp-tween-clip-secondary: #535353;
    --ugp-tween-card-background: #e2e2e2;
    --ugp-tween-card-border: #b4b4b4;
    --ugp-tween-card-toggle-on: #7db3e8;
    --ugp-tween-card-toggle-on-text: #000000;
    --ugp-tween-card-axis-border: #a8a8a8;
    --ugp-tween-card-axis-off: #e2e2e2;
    --ugp-tween-card-axis-off-text: #8a8a8a;
    --ugp-tween-card-axis-hover: rgba(0, 0, 0, 0.06);
    --ugp-tween-card-axis-x: #c8392b;
    --ugp-tween-card-axis-y: #4e8f1f;
    --ugp-tween-card-axis-z: #2f6bc4;
    --ugp-tween-card-axis-w: #a8740c;
}
