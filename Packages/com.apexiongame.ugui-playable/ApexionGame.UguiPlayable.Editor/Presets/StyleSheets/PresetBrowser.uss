.ugp-preset-browser {
    flex-grow: 1;
}

.ugp-preset-browser__toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ugp-preset-browser-line);
}

.ugp-preset-browser__toolbar-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.ugp-preset-browser__search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
}

.ugp-preset-browser__category {
    width: 120px;
    flex-shrink: 0;
    margin-left: 4px;
}

.ugp-preset-browser__body {
    flex-grow: 1;
    flex-direction: row;
}

.ugp-preset-browser__list {
    width: 220px;
    min-width: 140px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--ugp-preset-browser-line);
}

.ugp-preset-browser__group {
    margin: 6px 4px 2px 4px;
    -unity-font-style: bold;
    color: var(--ugp-preset-browser-secondary);
}

.ugp-preset-browser__item {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin: 0;
    padding: 2px 6px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.ugp-preset-browser__item:hover {
    background-color: var(--ugp-preset-browser-item-hover);
}

.ugp-preset-browser__item--selected,
.ugp-preset-browser__item--selected:hover {
    background-color: var(--ugp-preset-browser-item-selected);
}

.ugp-preset-browser__item-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.ugp-preset-browser__item-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ugp-preset-browser__empty {
    margin: 8px 6px;
    white-space: normal;
    color: var(--ugp-preset-browser-secondary);
}

.ugp-preset-browser__details {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 6px 8px;
}

.ugp-preset-browser__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.ugp-preset-browser__header-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.ugp-preset-browser__title {
    -unity-font-style: bold;
}

.ugp-preset-browser__description {
    margin-bottom: 6px;
    white-space: normal;
    color: var(--ugp-preset-browser-secondary);
}

.ugp-preset-browser__section {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--ugp-preset-browser-line);
}

.ugp-preset-browser__section-title {
    margin-bottom: 2px;
    -unity-font-style: bold;
}

.ugp-preset-browser__track {
    flex-direction: row;
    min-height: 18px;
}

.ugp-preset-browser__track-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ugp-preset-browser__track-path {
    flex-shrink: 0;
    margin-left: 8px;
    color: var(--ugp-preset-browser-secondary);
}

.ugp-preset-browser__actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.ugp-preset-browser__action {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 4px 0;
}

.ugp-preset-browser__action-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.ugp-preset-browser__note {
    margin: 2px 0;
    white-space: normal;
    color: var(--ugp-preset-browser-secondary);
}

.ugp-preset-browser__message {
    margin: 2px 0;
}
