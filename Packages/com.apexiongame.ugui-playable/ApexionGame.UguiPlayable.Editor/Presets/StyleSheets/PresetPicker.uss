.ugp-preset-picker {
    flex-grow: 1;
    padding: 4px;
}

.ugp-preset-picker__title {
    margin: 2px 2px 4px 2px;
    -unity-font-style: bold;
}

.ugp-preset-picker__note {
    margin: 0 2px 4px 2px;
    white-space: normal;
    color: var(--ugp-preset-picker-secondary);
}

.ugp-preset-picker__filters {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 4px 0;
}

.ugp-preset-picker__search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
}

.ugp-preset-picker__category {
    width: 110px;
    flex-shrink: 0;
    margin-left: 4px;
}

.ugp-preset-picker__list {
    flex-grow: 1;
    border-top-width: 1px;
    border-top-color: var(--ugp-preset-picker-line);
}

.ugp-preset-picker__item {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin: 0;
    padding: 2px 4px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.ugp-preset-picker__item:hover {
    background-color: var(--ugp-preset-picker-item-hover);
}

.ugp-preset-picker__item-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.ugp-preset-picker__item-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ugp-preset-picker__item-note {
    flex-shrink: 0;
    margin-left: 6px;
    color: var(--ugp-preset-picker-secondary);
}

.ugp-preset-picker__empty {
    margin: 6px 4px;
    color: var(--ugp-preset-picker-secondary);
}

.ugp-preset-picker__warning {
    margin: 2px 0;
}

.ugp-preset-picker__close {
    align-self: flex-end;
    margin-top: 6px;
}
