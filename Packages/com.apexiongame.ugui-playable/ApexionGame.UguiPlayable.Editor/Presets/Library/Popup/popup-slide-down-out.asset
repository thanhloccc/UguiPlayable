MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 73253eaa24e4c8549a2a4b522df9799d, type: 3}
  m_Name: popup-slide-down-out
  m_EditorClassIdentifier: ApexionGame.UguiPlayable.Editor::ApexionGame.UguiPlayable.Editor.Presets.TweenPreset
  _timeline: {fileID: 11400000, guid: 59555e0df8d1778459555991f778ccbf, type: 2}
  _category: popup
  _description: 'Slides the popup down and out: the backdrop and the popup fade from
    their current alpha to 0 (From current, In Quad) and the popup''s anchored position
    moves from its rest position to 300 units below (Relative 0 to offset, 0.3 s,
    In Cubic). The slide track is Revert, so the popup returns to rest when the graph
    stops (Play Mode); in Edit Mode preview, scrubbing back restores it. Binds backdrop
    and body/popup.'
  _icon: move
  _bindings:
  - _trackName: backdrop
    _path: backdrop
  - _trackName: popup-alpha
    _path: body/popup
  - _trackName: popup-slide
    _path: body/popup
