  m_Script: {fileID: 11500000, guid: 73253eaa24e4c8549a2a4b522df9799d, type: 3}
  m_Name: popup-pop-in
  m_EditorClassIdentifier: ApexionGame.UguiPlayable.Editor::ApexionGame.UguiPlayable.Editor.Presets.TweenPreset
  _timeline: {fileID: 11400000, guid: f395057180f15f34eb43c0d4572746c9, type: 2}
  _category: popup
  _description: 'Pops the popup in: the backdrop fades 0 to 1 (0.3 s, Out Quad);
    the popup fades 0 to 1 (0.2 s, Out Quad) and scales 0.8 to 1 (0.3 s, Out Back),
    all Absolute; it becomes interactable and blocks raycasts at the half-way point
    of its fade. Binds backdrop and body/popup.'
  _icon: scaling
  _bindings:
  - _trackName: backdrop
    _path: backdrop
  - _trackName: popup-alpha
    _path: body/popup
  - _trackName: popup-scale
    _path: body/popup
